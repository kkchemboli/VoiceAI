# Shared backend image foundation.
# Build a runtime with one of the targets below:
#   docker build -f Dockerfile.backend --target api -t expert-inst-api .
#   docker build -f Dockerfile.backend --target voice-agent -t expert-inst-voice-agent .
#   docker build -f Dockerfile.backend --target celery -t expert-inst-celery .

FROM python:3.12-slim AS backend-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Kolkata \
    HOME=/home/appuser

# libgomp1 is required by native ML/runtime dependencies used by the backend.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 tzdata \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./
RUN chown -R appuser:appuser /app/backend
USER appuser

# API runtime: HTTP control plane only.
FROM backend-base AS api
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# Voice runtime: LiveKit worker only.
FROM backend-base AS voice-agent
ENV SERVICE_NAME=voice-agent
STOPSIGNAL SIGTERM
# The worker has no HTTP listener; liveness is supplied by the orchestrator
# using the process/worker heartbeat rather than an API health endpoint.
CMD ["python", "agent.py", "start"]

# Celery worker runtime: asynchronous task execution only.
FROM backend-base AS celery-worker
ENV SERVICE_NAME=celery-worker
STOPSIGNAL SIGTERM
CMD ["celery", "-A", "services.celery_worker.app", "worker", "--loglevel=info"]

# Celery beat runtime: periodic schedule dispatch only. Run exactly one
# instance unless a distributed scheduler is introduced.
FROM backend-base AS celery-beat
ENV SERVICE_NAME=celery-beat
STOPSIGNAL SIGTERM
CMD ["celery", "-A", "services.celery_worker.app", "beat", "--loglevel=info"]

# Compatibility target for callers that still use --target celery. New
# deployments should select celery-worker or celery-beat explicitly.
FROM celery-worker AS celery
