# LiveKit Credentials
LIVEKIT_URL=wss://your-livekit-room.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Voice worker capacity.
# There is NO max-concurrent-calls setting in livekit-agents 1.5.x. These two
# knobs are what actually govern throughput:
#   VOICE_NUM_IDLE_PROCESSES - how many job processes stay warm. Not a cap; the
#     pool spawns beyond it on demand. A warm process skips spawn + prewarm
#     cost, so this is what absorbs a burst. Set to 0 for on-demand spawning
#     during local development.
#   VOICE_LOAD_THRESHOLD - CPU load (0-1) above which the worker reports itself
#     unavailable and LiveKit routes calls to another replica. This, not a
#     fixed number, is the real ceiling. Raise the pool size only while CPU has
#     headroom, otherwise calls just queue deeper.
# To scale past one pod, add replicas.
VOICE_NUM_IDLE_PROCESSES=4
VOICE_LOAD_THRESHOLD=0.7

# AI Models (Groq)
GROQ_API_KEY=your-groq-api-key
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Sarvam TTS
SARVAM_API_KEY=your-sarvam-api-key

# OpenAI (for conversation LLM and RAG embeddings)
OPENAI_API_KEY=your-openai-api-key
OPENAI_LLM_MODEL=gpt-4.1-mini

# Langfuse (LLM/voice-agent traces; create project keys in Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# EU Cloud default; use your Langfuse region or self-hosted base URL instead.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Telegram Summary (Optional)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# WABridge WhatsApp
WABRIDGE_AUTH_KEY=your-auth-key
WABRIDGE_APP_KEY=your-app-key
WABRIDGE_DEVICE_ID=your-device-id
WABRIDGE_TEMPLATE_ID=your-template-id
WABRIDGE_MEDIA_TYPE=text
