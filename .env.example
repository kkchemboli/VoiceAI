# LiveKit Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# AI Provider Keys
SARVAM_API_KEY=your_sarvam_api_key
GROQ_API_KEY=your_groq_api_key

# Telegram Summary Configuration
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Vobiz SIP Credentials (For Inbound/Outbound Trunks)
VOBIZ_SIP_SERVER=your_sip_server.vobiz.ai
VOBIZ_SIP_USER=your_username
VOBIZ_SIP_PASSWORD=your_password

# LiveKit SIP Outbound ID
# Get this from LiveKit Dashboard -> Telephony -> SIP Trunks after setup
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=SOT_XXXXXX
LIVEKIT_SIP_ROOM=outbound-call-room
